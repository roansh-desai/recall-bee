# No credentials are needed here when Bee CLI login manages authentication.
RECALL_MODE=live
# Fixture mode always uses a separate DB unless you explicitly override this.
# RECALL_DB=data/private/recall.sqlite
# BEE_BIN=bee
BEE_API_URL=http://127.0.0.1:8787
# Set false only if you already started bee proxy --port 8787 yourself.
RECALL_MANAGE_PROXY=true
# Optional direct public API configuration for todo write-back only:
# BEE_API_URL=https://api.developer.bee.amazon.dev
# BEE_TOKEN=your-token-entered-locally
