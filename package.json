{
  "name": "recall-bee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local, sourced people memory powered by Bee",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:fixture": "RECALL_MODE=fixture tsx scripts/dev.ts",
